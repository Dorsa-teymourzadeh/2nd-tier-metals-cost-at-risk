table Measures_Spend
	lineageTag: 8f5e30fc-c7f8-42f5-9565-05b811349caa

	measure 'Purchasing Spend' = SUM ( fact_should_cost[net_value_eur] )
		formatString: 0
		lineageTag: 31f850b9-180d-426a-be33-716517900a00

	measure 'Embedded Metal Value' =
			
			SUM ( fact_metal_exposure[metal_spend_eur] )
		formatString: #,0.0\ "€";-#,0.0\ "€";#,0.0\ "€"
		lineageTag: 5545dbaa-cb25-418f-929e-6e90f47756df

	measure 'Metal Share of Spend' = DIVIDE ( [Embedded Metal Value], [Purchasing Spend] )
		lineageTag: 7db7ee61-f096-44fe-9c06-25fe6d112638

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Embedded Metal (t)' = DIVIDE ( SUM ( fact_metal_exposure[metal_kg] ), 1000 )
		lineageTag: 1e15a5c6-d0a6-431c-b77a-dcd7b53c4c1f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

